NODE_ENV=development
API_PORT=4180
DATABASE_URL=postgresql://neighborly:neighborly@127.0.0.1:5432/neighborly
PGSSL=false
PGPOOL_MAX=10
JWT_SECRET=replace-with-at-least-32-random-characters
OTP_PEPPER=replace-with-a-different-random-secret
BOOTSTRAP_SUPER_ADMIN_MOBILE=+919876543210
BOOTSTRAP_SUPER_ADMIN_NAME=Bizearch Super Admin
NEIGHBORLY_SOS_ALERT_STORE=.neighborly-sos-alerts.json
NEIGHBORLY_SUPER_ADMIN_EMAIL=superadmin@example.com
NEIGHBORLY_SUPER_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Leave Twilio and MSG91 unset for local demo OTPs printed to the API console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Razorpay is inactive until live API keys are configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
