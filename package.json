{
  "name": "neighborly-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Neighborly marketplace: React, Express, JWT and PostgreSQL",
  "type": "module",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch backend/src/server.js",
    "dev:web": "vite --config frontend/vite.config.js --host 127.0.0.1",
    "build": "vite --config frontend/vite.config.js build",
    "db:schema": "node backend/src/db/apply-schema.js",
    "db:bootstrap-admin": "node backend/src/db/bootstrap-superadmin.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.0",
    "vite": "^7.1.4"
  },
  "engines": { "node": ">=20" }
}
