{
  "name": "neighborly-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Bizearch marketplace with React, Express, PostgreSQL and a Next.js demo",
  "type": "module",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch backend/src/server.js",
    "dev:web": "vite --config frontend/vite.config.js --host 0.0.0.0",
    "build": "vite --config frontend/vite.config.js build",
    "db:schema": "node backend/src/db/apply-schema.js",
    "db:bootstrap-admin": "node backend/src/db/bootstrap-superadmin.js",
    "db:seed-demo": "node backend/src/db/seed-demo.js",
    "dev:next": "next dev --hostname 0.0.0.0",
    "build:next": "next build",
    "start:next": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "next": "16.4.2",
    "pg": "^8.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
